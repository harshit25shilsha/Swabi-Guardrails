# --- Guardrail API auth (existing backend will send this in Authorization header)
GUARDRAIL_API_TOKEN=replace-with-a-long-random-token

# --- Groq LLM
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_CONSENSUS_ATTEMPTS=2

# Gemini fallback (used when Groq is unavailable)
GEMINI_API_KEY=Your api key 
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
LLM_FALLBACK_ENABLED=true

# Observability
SERVICE_VERSION=0.2.0
LOG_LEVEL=INFO
LOG_FORMAT=json          # json | text

 # Circuit breaker around the Groq call
LLM_CIRCUIT_FAILURE_THRESHOLD: int = 5
LLM_CIRCUIT_OPEN_SECONDS: int = 60

