# --- Guardrail API auth (existing backend will send this in Authorization header)
GUARDRAIL_API_TOKEN=replace-with-a-long-random-token

# --- Groq LLM
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_CONSENSUS_ATTEMPTS=2

# --- Optional
LOG_LEVEL=INFO